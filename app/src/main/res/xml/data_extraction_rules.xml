<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_session.xml" />
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="database" path="inspections.db" />
        <exclude domain="database" path="inspections.db-wal" />
        <exclude domain="database" path="inspections.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_session.xml" />
        <exclude domain="file" path="last-crash.txt" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="database" path="inspections.db" />
        <exclude domain="database" path="inspections.db-wal" />
        <exclude domain="database" path="inspections.db-shm" />
    </device-transfer>
</data-extraction-rules>
